<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nas.supacode-companion</string>

  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/.bun/bin/bun</string>
    <string>run</string>
    <string>/PATH/TO/supacode-companion/server.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/PATH/TO/supacode-companion</string>

  <!-- zmx, supacode and git must be on PATH; launchd's default PATH is minimal. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/PATH/TO/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>

  <key>StandardOutPath</key>
  <string>/PATH/TO/supacode-companion/logs/companion.log</string>
  <key>StandardErrorPath</key>
  <string>/PATH/TO/supacode-companion/logs/companion.err</string>
</dict>
</plist>
