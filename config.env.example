# Copy to ~/.claude/companion/config.env and chmod 600.
# Deliberately outside the repo: the topic is the only thing gating who can
# read your prompts and push to you.

# Anything unguessable. Whoever knows this string receives your notifications.
NTFY_TOPIC=supacode-<random>

# Where a tapped notification sends the phone, and where its action buttons
# POST back to.
#
# This MUST be reachable FROM THE PHONE. ntfy's http actions are performed by
# the ntfy app on the phone, from the phone's own network — so a loopback value
# here points every button at the phone itself and silently does nothing. That
# was the real bug: DASH_URL was http://127.0.0.1:7777 and every notification
# tap had been dead since notifications existed.
#
# After renaming the machine, update this too: `tailscale serve` binds to the
# OLD DNS name, so a rename leaves the URL resolving to nothing.
# `bin/sup status` checks both.
DASH_URL=https://<machine>.<tailnet>.ts.net
